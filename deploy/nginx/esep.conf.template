# Подставляется при запуске контейнера: заменяется только ${ESEP_DOMAIN}.
server_tokens off;

# Ограничиваются только отправки форм: просмотр страниц от них не страдает.
map $request_method $post_client {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $post_client zone=auth:10m rate=10r/m;
limit_req_zone $post_client zone=upload:10m rate=10r/m;
limit_req_status 429;

upstream esep_app {
    server app:8080;
}

server {
    listen 80 default_server;
    server_name ${ESEP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# Запрос с чужим именем хоста не доходит до приложения.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/${ESEP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ESEP_DOMAIN}/privkey.pem;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ESEP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ESEP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ESEP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:esep_tls:10m;
    ssl_session_tickets off;

    # Чуть больше лимита приложения, чтобы отказ показывала его понятная страница 413.
    client_max_body_size 7m;

    include /etc/nginx/esep-access.conf;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    location /actuator/ {
        return 404;
    }
    location ~ ^/(login|register|account/delete)$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://esep_app;
    }
    location ~ ^/(check|import|api/statements/import)$ {
        limit_req zone=upload burst=3 nodelay;
        proxy_pass http://esep_app;
    }
    location / {
        proxy_pass http://esep_app;
    }
}
